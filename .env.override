# TechX de-brand: build & push under nghiadaulau, neutral version 1.0

# Bedrock resilience baseline for Product Reviews and Shopping Copilot.
# Mandate 25 live tests read these values; tune them here between runs.
AI_CACHE_ENABLED=true
MEM0_READ_ENABLED=true
MEM0_WRITE_ENABLED=true
AI_GUARDRAIL_REQUIRE_MODEL=true
BEDROCK_CONNECT_TIMEOUT_SECONDS=2
BEDROCK_READ_TIMEOUT_SECONDS=10
BEDROCK_MAX_ATTEMPTS=2
BEDROCK_BACKOFF_BASE_SECONDS=0.25
BEDROCK_BACKOFF_MAX_SECONDS=1
BEDROCK_SCHEMA_MAX_ATTEMPTS=2
BEDROCK_TOTAL_DEADLINE_SECONDS=15
BEDROCK_BREAKER_FAILURE_THRESHOLD=3
BEDROCK_BREAKER_RECOVERY_SECONDS=30

# Mandate 25 harness limits (not passed to Bedrock itself).
MANDATE25_RPC_TIMEOUT_SECONDS=25
MANDATE25_FALLBACK_LATENCY_LIMIT_SECONDS=20
MANDATE25_PRODUCT_REVIEW_FALLBACK_LATENCY_LIMIT_SECONDS=15
MANDATE25_SERVICE_START_TIMEOUT_SECONDS=120

IMAGE_NAME=493499579600.dkr.ecr.us-east-1.amazonaws.com/techx-dev-corp
IMAGE_VERSION=1.0
DEMO_VERSION=latest

