      "promql": "(max(rate(postgresql_commits[5m])) or max(rate(postgresql_commits_total[5m]))) + (max(rate(postgresql_rollbacks[5m])) or max(rate(postgresql_rollbacks_total[5m])))",
      "unit": "requests_per_second",
      "window": "5m",
