      "promql": "(sum(rate(container_network_receive_bytes_total{namespace=\"techx-corp-prod\",pod=~\"otel-collector-.*\"}[5m])) + sum(rate(container_network_transmit_bytes_total{namespace=\"techx-corp-prod\",pod=~\"otel-collector-.*\"}[5m]))) or (sum(rate(container_network_receive_bytes_total{pod=~\"otel-collector-.*\"}[5m])) + sum(rate(container_network_transmit_bytes_total{pod=~\"otel-collector-.*\"}[5m])))",
