      "query_id_template": "$service.db_pool_utilization",
      "signal_id_template": "${service_id}_db_pool_utilization",
      "promql": "(sum(db_client_connection_count{service_name=\"$service\",db_client_connection_state=\"used\"}) / clamp_min(sum(db_client_connection_max{service_name=\"$service\"}), 1)) and on() (sum(db_client_connection_max{service_name=\"$service\"}) > 0)",
      "unit": "ratio",
