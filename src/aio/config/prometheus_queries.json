      "promql": "(((sum(rate(traces_span_metrics_calls_total{service_name=\"$service\",span_kind=\"SPAN_KIND_CLIENT\",span_name=~\"$dependency_span\",status_code=\"STATUS_CODE_ERROR\"}[5m])) or 0 * sum(rate(traces_span_metrics_calls_total{service_name=\"$service\",span_kind=\"SPAN_KIND_CLIENT\",span_name=~\"$dependency_span\"}[5m]))) / clamp_min(sum(rate(traces_span_metrics_calls_total{service_name=\"$service\",span_kind=\"SPAN_KIND_CLIENT\",span_name=~\"$dependency_span\"}[5m])), 0.000000001)) and on() (sum(rate(traces_span_metrics_calls_total{service_name=\"$service\",span_kind=\"SPAN_KIND_CLIENT\",span_name=~\"$dependency_span\"}[5m])) > 0))",
