      "signal_id_template": "otel_collector_request_rate_5m",
      "promql": "sum(rate(otelcol_receiver_accepted_spans_total[5m])) + sum(rate(otelcol_receiver_accepted_metric_points_total[5m])) + sum(rate(otelcol_receiver_accepted_log_records_total[5m]))",
