    "managed.postgresql.socket_io": {
      "query_id_template": "postgresql.socket_io_bytes_per_second",
      "signal_id_template": "postgresql_socket_io_bytes_per_second",
      "promql": "sum(aws_rds_network_receive_throughput_average{dimension_DBInstanceIdentifier=\"techx-prod-tf2-postgresql\"}) + sum(aws_rds_network_transmit_throughput_average{dimension_DBInstanceIdentifier=\"techx-prod-tf2-postgresql\"})",
      "unit": "bytes_per_second",
      "window": "5m",
      "metric": "socket_io_bytes_per_second",
      "feature_role": "anomaly_input",
